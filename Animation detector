-- Function to create hover effect
local function addHoverEffect(button)
    local originalColor = button.BackgroundColor3
    button.MouseEnter:Connect(function()
        if button ~= selectedHistoryButton then
            TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(originalColor.R * 255 * 1.2, originalColor.G * 255 * 1.2, originalColor.B * 255 * 1.2)}):Play()
        end
    end)
    button.MouseLeave:Connect(function()
        if button ~= selectedHistoryButton then
            TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play()
        end
    end)
end

-- Apply hover effects
addHoverEffect(copyButton)
addHoverEffect(playButton)
addHoverEffect(minimizeButton)
addHoverEffect(clearButton)

-- Function to update selected history button
local function updateSelectedButton(button)
    if selectedHistoryButton then
        TweenService:Create(selectedHistoryButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
    end
    selectedHistoryButton = button
    if button then
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
    end
end

-- Function to add animation to history
local function addToHistory(animId)
    if not table.find(animationHistory, animId) then
        table.insert(animationHistory, 1, animId)
        if #animationHistory > 10 then
            table.remove(animationHistory, #animationHistory)
        end
        
        -- Clear current history
        for _, child in ipairs(scrollingFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        
        -- Populate history
        for i, id in ipairs(animationHistory) do
            local historyButton = Instance.new("TextButton")
            historyButton.Size = UDim2.new(1, -10, 0, 30)
            historyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            historyButton.Text = id
            historyButton.TextColor3 = Color3.fromRGB(200, 200, 200)
            historyButton.TextScaled = true
            historyButton.Font = Enum.Font.Gotham
            historyButton.LayoutOrder = i
            historyButton.Parent = scrollingFrame
            local historyCorner = Instance.new("UICorner")
            historyCorner.CornerRadius = UDim.new(0, 6)
            historyCorner.Parent = historyButton
            addHoverEffect(historyButton)
            
            historyButton.MouseButton1Click:Connect(function()
                currentAnimationId = id
                idLabel.Text = "ID: " .. id
                updateSelectedButton(historyButton)
                StarterGui:SetCore("SendNotification", {
                    Title = "Selected",
                    Text = "Animation ID selected.",
                    Duration = 2
                })
            end)
        end
        
        scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, uiListLayout.AbsoluteContentSize.Y)
    end
end

-- Function to clear history
local function clearHistory()
    animationHistory = {}
    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    updateSelectedButton(nil)
    StarterGui:SetCore("SendNotification", {
        Title = "History Cleared",
        Text = "Animation history has been cleared.",
        Duration = 2
    })
end

-- Function to update GUI with Animation ID
local function updateGui(animationTrack)
    if animationTrack and animationTrack.Animation then
        local animId = animationTrack.Animation.AnimationId
        idLabel.Text = "ID: " .. animId
        currentAnimationId = animId
        addToHistory(animId)
        updateSelectedButton(nil) -- Deselect history when new animation plays
    else
        idLabel.Text = "ID: None"
        currentAnimationId = nil
        updateSelectedButton(nil)
    end
end

-- Function to detect animation changes
local function setupAnimationDetection()
    if not humanoid or not animator then
        player.CharacterAdded:Connect(function(character)
            humanoid = character:WaitForChild("Humanoid")
            animator = humanoid:WaitForChild("Animator")
            animator.AnimationPlayed:Connect(function(animationTrack)
                updateGui(animationTrack)
            end)
        end)
    else
        animator.AnimationPlayed:Connect(function(animationTrack)
            updateGui(animationTrack)
        end)
    end
end

