--// DynamicIslandNotify v2
--// Dynamic Island styled notifications with custom sound + decal support

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local DynamicIslandNotify = {}

-- Settings
local MAX_NOTIFICATIONS = 3
local NOTIFICATION_LIFETIME = 4 -- seconds
local QUEUE_MODE = "Replace"

-- Container
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DynamicIslandGUI"
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game:GetService("CoreGui")

local Container = Instance.new("Frame")
Container.Name = "NotificationContainer"
Container.AnchorPoint = Vector2.new(0,0)
Container.Position = UDim2.new(0, 20, 0, 40)
Container.Size = UDim2.new(0, 300, 1, -40)
Container.BackgroundTransparency = 1
Container.Parent = ScreenGui

local activeNotifications = {}

-- Default sounds for each type
local DefaultSounds = {
    Info = "rbxassetid://9118823106",    -- soft ping
    Success = "rbxassetid://6026984224", -- success chime
    Warning = "rbxassetid://6026984226", -- warning tone
    Error = "rbxassetid://6026984225",   -- error buzz
}

-- Default colors
local TypeColors = {
    Info = Color3.fromRGB(0,162,255),
    Success = Color3.fromRGB(0,200,100),
    Warning = Color3.fromRGB(255,200,0),
    Error = Color3.fromRGB(220,50,50),
}

--// Create Notification
function DynamicIslandNotify:Notify(config)
    local title = config.Title or "Notification"
    local msg = config.Message or ""
    local type = config.Type or "Info"
    local soundId = config.SoundId or DefaultSounds[type]
    local decalId = config.DecalId -- optional image

    local color = TypeColors[type] or TypeColors.Info

    -- Limit active notifications
    if #activeNotifications >= MAX_NOTIFICATIONS then
        if QUEUE_MODE == "Replace" then
            local oldest = table.remove(activeNotifications, 1)
            if oldest and oldest.Destroy then oldest:Destroy() end
        end
    end

    -- Main frame (pill style)
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 0, 0, 0)
    notif.Position = UDim2.new(0, 0, 0, #activeNotifications * 80)
    notif.BackgroundColor3 = Color3.fromRGB(25,25,25)
    notif.BackgroundTransparency = 0.1
    notif.BorderSizePixel = 0
    notif.ClipsDescendants = true
    notif.Parent = Container

    local corner = Instance.new("UICorner", notif)
    corner.CornerRadius = UDim.new(0, 30)

    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = color
    stroke.Thickness = 2
    stroke.Transparency = 0.2

    -- Left icon/decal holder
    local iconFrame = Instance.new("Frame")
    iconFrame.Size = UDim2.new(0, 40, 0, 40)
    iconFrame.Position = UDim2.new(0, 10, 0.5, -20)
    iconFrame.BackgroundTransparency = 1
    iconFrame.Parent = notif

    if decalId then
        local icon = Instance.new("ImageLabel")
        icon.Size = UDim2.new(1,0,1,0)
        icon.BackgroundTransparency = 1
        icon.Image = "rbxassetid://"..decalId
        icon.Parent = iconFrame
    end

    -- Title
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -60, 0, 24)
    titleLabel.Position = UDim2.new(0, 60, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 18
    titleLabel.TextColor3 = Color3.new(1,1,1)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = notif

    -- Message
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -60, 0, 20)
    msgLabel.Position = UDim2.new(0, 60, 0, 34)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = msg
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextSize = 14
    msgLabel.TextColor3 = Color3.fromRGB(200,200,200)
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Parent = notif

    table.insert(activeNotifications, notif)

    -- Play sound
    if soundId then
        local s = Instance.new("Sound")
        s.SoundId = soundId
        s.Volume = 1
        s.Parent = SoundService
        s:Play()
        game:GetService("Debris"):AddItem(s,5)
    end

    -- Entry animation (expand → bounce)
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 280, 0, 60)}):Play()

    -- Pulse effect (like iPhone)
    task.delay(0.4, function()
        TweenService:Create(notif, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Size = UDim2.new(0, 300, 0, 65)}):Play()
        task.wait(0.15)
        TweenService:Create(notif, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Size = UDim2.new(0, 280, 0, 60)}):Play()
    end)

    -- Auto close
    task.delay(NOTIFICATION_LIFETIME, function()
        if notif and notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {Size = UDim2.new(0, 0, 0, 0)}):Play()
            task.wait(0.25)
            notif:Destroy()
        end
    end)
end

return DynamicIslandNotify
